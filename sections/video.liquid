<div class="video-container">
  <video class="video-preview" autoplay loop muted>
    <source src="{{ '-ab79-46de-8529-9b23b22cddee.mp4' | asset_url }}" type="video/mp4">
  </video>
</div>

{% style %}
  .video-container {position: relative;width: 100%;height: 100vh; /* Full height */overflow: hidden;}
  .video-preview {position: absolute;{% comment %}top: -10%;{% endcomment %}top:0;left: 0;width: 100%;height: 100%;object-fit: cover;}
{% endstyle %}

{% schema %}
{
  "name": "t:sections.video.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
      "label": "t:sections.video.settings.video_url.label",
      "info": "t:sections.video.settings.video_url.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.video.presets.name"
    }
  ]
}
{% endschema %}
