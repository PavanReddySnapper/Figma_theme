
<div class="text-section">
    <div class="overlay"></div> <!-- Overlay for reducing exposure -->
    <div class="text">
       <div id="top-text">
        {{ section.settings.button_label_1 | upcase }}
       </div>
       <div id="bottom-text">
        {{ section.settings.button_label_2 | upcase }}
       </div>
    </div>
    <div class="demo-pictures">
        <div id="img-1">
            <img src="{{ section.settings.image_1 | image_url }}" alt="Image 1">
        </div>
        <div id="img-2">
            <img src="{{ section.settings.image_2 | image_url }}" alt="Image 2">
        </div>
        <div id="img-3">
            <img src="{{ section.settings.image_3 | img_url:'500x'}}" alt="Image 3">
        </div>
    </div>
    
  </div>

{% style %}
.text-section{
    
    width:100%;
}
  .text{
    width:100%;
    margin:20px auto;
    text-align:center;
    padding:10px;
  }

  #top-text{
    color:#bfbeb6;
font-weight: 800;
font-size: 28px;
line-height: 150%;
letter-spacing: 0%;
text-align: center;
text-transform: uppercase;


  }
  #bottom-text{
    color:#bfbeb6;
    font-weight: 800;
    font-size: 28px;
    line-height: 42px;
    letter-spacing: 0%;
    text-align: center;
  }
  #img-1 {
    display: flex;
    justify-content: center; /* Centers the image horizontally */
    align-items: center; /* Centers the image vertically if the parent has a fixed height */
}

  #img-2,#img-3{
    display:none;
  }
  
   #img-1 img{
     margin:5px;
     max-width:320px;
     height:530px;
     object-fit: cover;
     border-radius:20px;
   }

   @media screen and (min-width:600px)
   {
    .text{
        width:70%;
    }
    #top-text{
      padding: 0px 120px;
    }
      #top-text, #bottom-text{
        
        font-weight: 1310px;
        font-size: 97px;
        line-height: 102.82px;
        letter-spacing: 2%;
        text-align: center;
      }
      #img-2,#img-3{
       display:block;
     }
     .demo-pictures{
        display:flex;
        justify-content:space-around;
     }

     #img-1 img, #img-2 img, #img-3 img{
        width:auto;
        max-width:550px;
        height:830px;
        object-fit: cover;
        border-radius:20px ;
     }
   }
{% endstyle %}


{%  schema %}
{
  "name":"text-section",
  "settings": [
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Image 1",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Image 3",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "text",
        "id": "button_label_1",
        "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
        "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
      },
      {
        "type": "text",
        "id": "button_label_2",
        "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
        "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
      },
  ],
  "presets": [
    {
     "name":"text-section"
    }
  ]
}
{%  endschema %}