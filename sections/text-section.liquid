
<div class="text-section">
    <div class="overlay"></div> <!-- Overlay for reducing exposure -->
    <div class="text">
       <div id="top-text">
        {{ section.settings.button_label_1 }}
       </div>
       <div id="bottom-text">
        {{ section.settings.button_label_2 }}
       </div>
    </div>
    <div class="demo-pictures">
        <div id="img-1">
            <img src="{{ section.settings.image_1 | image_url }}" alt="Image 1">
        </div>
        <div id="img-2">
            <img src="{{ section.settings.image_2 | image_url }}" alt="Image 2">
        </div>
        <div id="img-3">
            <img src="{{ section.settings.image_3 | img_url:'500x'}}" alt="Image 3">
        </div>
    </div>
</div>

{% style %}
/* Overlay to reduce exposure (darken/lighten effect) */

/* Optional: Add a semi-transparent overlay to reduce image exposure */
.text-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color:rgb(211, 210, 205); /* Background color overlay */
      opacity: 0.5; /* Adjust this to control how much of the image is visible */
      z-index: -1;
  }
.text-section{
    padding:30px;
      position: relative; /* Allows precise positioning */
      background-image: url('{{ section.settings.background_image | image_url }}');
      background-size: 1000px 1000px; /* Exact dimensions */
        background-repeat: no-repeat;
        background-position: -505px 250px; /* Aligns the image */
      background-color: #D4D3CE; /* Base background color */
      width:100%;
      height: 900px;
      gap: 0px;
      opacity: 1; /* Make sure the image is visible */
      overflow: hidden; /* Prevents extra overflow */
    width:100%;
}
  .text{
    width:80%;
    margin:20px auto;
    text-align:center;
  }

  #top-text{
    font-family: Poppins;
    font-weight: 800;
    font-size: 28px;
    line-height: 42px;
    letter-spacing: 0%;
    text-align: center;

  }
  #bottom-text{
    font-family: Poppins;
    font-weight: 800;
    font-size: 28px;
    line-height: 42px;
    letter-spacing: 0%;
    text-align: center;
  }
  #img-1 {
    display: flex;
    justify-content: center; /* Centers the image horizontally */
    align-items: center; /* Centers the image vertically if the parent has a fixed height */
}

  #img-2,#img-3{
    display:none;
  }
  
   #img-1 img{
     width:350px;
     height:530px;
     object-fit: cover;
     border-radius:20px;
   }

   @media screen and (min-width:600px)
   {
    .text-section{
        height:1850px;
        background-size: 2635px 2565px; /* Exact dimensions */
      background-repeat: no-repeat;
      background-position: -1605px 600px; /* Aligns the image */
    }
    .text{
        width:50%;
    }
      #top-text, #bottom-text{
        font-family: Poppins;
        font-weight: 700;
        font-size: 97px;
        line-height: 102.82px;
        letter-spacing: 2%;
        text-align: center;
      }
      #img-2,#img-3{
       display:block;
     }
     .demo-pictures{
        display:flex;
        justify-content:space-around;
     }

     #img-1 img, #img-2 img, #img-3 img{
        width:550px;
        height:830px;
        object-fit: cover;
        border-radius:20px 0px 20px 0px;
     }
   }
{% endstyle %}


{%  schema %}
{
  "name":"text-section",
  "settings": [
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Image 1",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Image 3",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "text",
        "id": "button_label_1",
        "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
        "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
      },
      {
        "type": "text",
        "id": "button_label_2",
        "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
        "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
      },
  ],
  "presets": [
    {
     "name":"text-section"
    }
  ]
}
{%  endschema %}