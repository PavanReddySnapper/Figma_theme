


<div class="text-section">
    <div class="overlay"></div> <!-- Overlay for reducing exposure -->
    <div class="text">
       <div id="top-text">
        {{ section.settings.button_label_1 }}
       </div>
       <div id="bottom-text">
        {{ section.settings.button_label_2 }}
       </div>
    </div>
    <div class="demo-pictures">
        <div id="img-1">
            <img src="{{ section.settings.image_1 | image_url }}" alt="Image 1">
        </div>
        <div id="img-2">
            <img src="{{ section.settings.image_2 | image_url }}" alt="Image 2">
        </div>
        <div id="img-3">
            <img src="{{ section.settings.image_3 | image_url }}" alt="Image 3">
        </div>
    </div>
</div>

{% style %}
  
  /* Background styles */
  .text-section {
      padding:30px;
      position: relative; /* Allows precise positioning */
      background-image: url('{{ section.settings.background_image | image_url }}');
      background-size: 2635px 2565px; /* Exact dimensions */
      background-repeat: no-repeat;
      background-position: -1605px 600px; /* Aligns the image */
      background-color: #D4D3CE; /* Base background color */
      width:100%;
      height: 1850px;
      gap: 0px;
      opacity: 1; /* Make sure the image is visible */
      overflow: hidden; /* Prevents extra overflow */
  }

  /* Optional: Add a semi-transparent overlay to reduce image exposure */
  .text-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color:rgb(211, 210, 205); /* Background color overlay */
      opacity: 0.5; /* Adjust this to control how much of the image is visible */
      z-index: 1;
  }
  
  /* Ensuring text and images appear above overlay */
  .text, .demo-pictures {
      position: relative;
      z-index: 2;
      color: black;
      left:80px;
  }
  /* Styling #top-text */
  #top-text {
      position: absolute;
      width: 1164px;
      height: 309px;
      top: 100px;
      left: 398px;
      gap: 0px;
      opacity: 0.7;
      font-family: Poppins; /* Applied Poppins font */
      font-size: 97px; /* Set font size */
      font-style: italic; /* Set italic style */
      font-weight: 700; /* Set font weight */
      line-height: 102.82px; /* Adjust line height */
      letter-spacing: 0.02em; /* Adjust letter spacing */
      text-align: center; /* Center-align text */
      text-underline-position: from-font; /* Underline from font */
      text-decoration-skip-ink: none; /* Ensures text decoration is skipped */
      color: black; /* Set text color */
  }

  #bottom-text {
      position: absolute;
      width: 1313px;
      height: 309px;
      top: 420px; /* Adjust placement */
      left: 331px;
      gap: 0px;
      opacity: 0.7;
      font-family: Poppins;
      font-size: 97px;
      font-style: italic;
      font-weight: 700;
      line-height: 102.82px;
      letter-spacing: 0.02em;
      text-align: center;
      text-underline-position: from-font;
      text-decoration-skip-ink: none;
      color:#6B6B68;
  }
  /* Styling Image 1 */
  #img-1 img {
      position: absolute;
      width: 567px;
      height: 858px;
      top: 909px;
      left: 80px;
      gap: 0px;
      border-radius: 20px 0px 0px 0px;
      opacity: 1;
      object-fit: cover;
  }

  /* Styling Image 2 */
  #img-2 img {
      position: absolute;
      width: 566px;
      height: 858px;
      top: 909px;
      left: 677px;
      gap: 0px;
      border-radius: 20px 0px 0px 0px;
      opacity: 1;
      object-fit: cover;
      box-shadow: 0px 4px 32px 0px #D6CCB6;

  }

  /* Styling Image 3 */
  #img-3 img {
      position: absolute;
      width: 567px;
      height: 858px;
      top: 909px;
      left: 1273px;
      gap: 0px;
      border-radius: 20px 0px 0px 0px;
      opacity: 1;
      object-fit: cover;
      box-shadow: 0px 4px 32px 0px #D6CCB6;

  }

  /* Ensure images don't break layout */
  .demo-pictures img {
      max-width: 100%;
      height: auto;
  }

  @media (max-width: 600px){
    .text-section{
        height:900px;
        background-size: 1000px 1000px; /* Exact dimensions */
        background-repeat: no-repeat;
        background-position: -505px 250px; /* Aligns the image */
    }

    #img-2 img,#img-3 img {
        display:none;
    }

    #img-1 img{
        top:400px;
        width: 90%;
        height: 420px;
        left: 7px;
        border-radius: 20px;
    }

    #top-text{
        width: 90%;
        height: 126px;
        top: 20px;
        left: 7px;
        font-size:28px;
        line-height:42px;
    }
    #bottom-text{
        width: 90%;
        height: 126px;
        top: 160px;
        left: 7px;
        font-size:28px;
        line-height:42px;
    }
}
{% endstyle %}


{%  schema %}
{
  "name":"text-section",
  "settings": [
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_1",
        "label": "Image 1",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_2",
        "label": "Image 2",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "image_picker",
        "id": "image_3",
        "label": "Image 3",
        "info": "Upload an image to use as the background for this section."
      },
      {
        "type": "text",
        "id": "button_label_1",
        "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
        "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
      },
      {
        "type": "text",
        "id": "button_label_2",
        "label": "t:sections.rich-text.blocks.buttons.settings.button_label_2.label",
        "info": "t:sections.rich-text.blocks.buttons.settings.button_label_2.info"
      },
  ],
  "presets": [
    {
     "name":"text-section"
    }
  ]
}
{%  endschema %}