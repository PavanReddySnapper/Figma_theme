{% schema %}
{
  "name": "Tab Panel",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tab Title"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Tab Content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tab Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tab Panel",
      "blocks": [
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}

<div class="tab-panel">
  <ul class="tab-list">
    {% for block in section.blocks %}
      <li>
        <button class="tab-button {% if forloop.first %}active{% endif %}" data-tab="tab-{{ block.id }}">{{ block.settings.title }}</button>
      </li>
    {% endfor %}
  </ul>
  
  {% for block in section.blocks %}
    <div id="tab-{{ block.id }}" class="tab-content {% if forloop.first %}active{% endif %}">
      <h2>{{ block.settings.title }}</h2>
      <p>{{ block.settings.content }}</p>
      {% if block.settings.image %}
        <img src="{{ block.settings.image | img_url: 'medium' }}" alt="{{ block.settings.title }}">
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
    
        .tab-panel {
          max-width: 800px;
          margin: auto;
          text-align: left;
          font-family: Arial, sans-serif;
        }
      
        .tab-list {
          list-style: none;
          display: flex;
          justify-content: center;
          padding: 0;
          
        }
      
        .tab-button {
        
          background: none;
          border: none;
          padding: 10px 20px;
          cursor: pointer;
          font-size: 18px;
          color: #333;
          font-weight: normal;
        }
      
        .tab-button.active {
          font-weight: bold;
          border-bottom: 2px solid #000;
        }
      
        .tab-content {
            text-align:left;
          display: none;
          padding: 20px 0;
        }
      
        .tab-content.active {
          display: block;
        }
      
        .tab-content h2 {
          border-bottom:1px solid #000;
          font-size: 24px;
          font-weight: bold;
          margin-bottom: 10px;
        }
      
        .tab-content p {
          font-size: 16px;
          line-height: 1.5;
        }
      
        .tab-content img {
          width: 100%;
          height: 400px;
          margin-top: 15px;
        }
     
      
  .tab-panel { text-align: center; }
  .tab-list { list-style: none; display: flex; justify-content: center; }
  .tab-button { margin: 5px; padding: 10px; cursor: pointer; }
  .tab-button.active { font-weight: bold; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const tabs = document.querySelectorAll(".tab-button");
    const contents = document.querySelectorAll(".tab-content");
    
    function activateTab(tab) {
      tabs.forEach(t => t.classList.remove("active"));
      contents.forEach(c => c.classList.remove("active"));
      
      tab.classList.add("active");
      document.getElementById(tab.dataset.tab).classList.add("active");
    }
    
    tabs.forEach(tab => {
      tab.addEventListener("click", function() {
        activateTab(this);
      });
    });
    
    // Activate the first tab by default
    if (tabs.length > 0) {
      activateTab(tabs[0]);
    }
  });
</script>