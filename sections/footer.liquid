{%- assign image_block = section.blocks | where: 'type', 'image' | first -%}
{% style %}
   .footer{
    width:100%;
   
    background:black;
    color:#ffffff;
   }
   .footer-grid{
     display:grid;
     grid-template-columns:1fr;
    }

    .footer-top{
     display:grid;
     grid-template-columns:1fr 1fr;
    }
    .footer-menu__title{
      font-family: Assistant, sans-serif;
      font-weight: 600;
      font-size: 26px;
      line-height: 31.2px;
      letter-spacing: 0%;
      text-align: center;
      margin-bottom:0px;
      margin-top:20px;
      padding-left:0;
      color:rgb(95, 95, 95);
    }

    .footer-menu__list{
     list-style:none;
     padding:0px;
    }

   .footer-menu__list-item a, .footer-socials a{
    text-decoration:none;
    color:#ffffff;
    font-family: Assistant, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0%;
    text-align: center;

   }
   
    .footer-socials{
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }
   .footer-menu{
     display:flex;
     flex-direction:column;
     align-items:flex-start;
     padding-left:35px;
   }
   .footer-logo{
    display: flex;
    justify-content: center;
    align-items: center;
    margin:20px auto;
   }
   .footer-logo img{
    width:90%;
    height:121px;
   }

   .footer-text{
    font-family: Poppins;
font-weight: 400;
font-size: 14px;
line-height: 16.8px;
letter-spacing: 0%;
text-align: center;

   }
{% endstyle %}
<footer
  class="footer{% if image_block %} footer--has-image{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="footer"
>
  <div class="footer-grid">
    <div class="footer-top">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = false
          case block.type
            when 'text'
              continue
            when 'image'
              continue
            when 'menu'
              assign title = linklists[block.settings.block_linklist].title
            when 'social_media'
              assign title = block.settings.title
          endcase
        -%}
        <div class="footer-menu footer-menu--{{ block.type }}">
          {% if title != blank %}
            <h3 class="footer-menu__title h6">{{ title }}</h3>
          {% endif %}

          {%- if block.type == 'menu' -%}
            <ul class="footer-menu__list" role="list">
              {% for link in linklists[block.settings.block_linklist].links %}
                <li class="footer-menu__list-item body-medium" role="listitem">
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {%- elsif block.type == 'social_media' -%}
            <div class="footer-socials" style="margin-top:18px">
              {% if block.settings.facebook_url != blank %}
                <a style="padding-bottom:5px;text-align: left;" href="{{ block.settings.facebook_url }}" target="_blank">FACEBOOK</a>
              {% endif %}
              {% if block.settings.twitter_url != blank %}
                <a style="padding-bottom:5px;text-align: left;" href="{{ block.settings.twitter_url }}" target="_blank">TWITTER</a>
              {% endif %}
              {% if block.settings.instagram_url != blank %}
                <a style="padding-bottom:5px;text-align:left" href="{{ block.settings.instagram_url }}" target="_blank">INSTAGRAM</a>
              {% endif %}
            </div>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
    <div class="footer-bottom">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = false
          case block.type
            when 'text'
            assign title = block.id
            when 'image'
            assign title = block.id
            when 'menu'
            continue
            when 'social_media'
            continue
          endcase
        -%}
        {%- if block.type == 'image' -%}
        <div class="footer-logo">
          {% if block.settings.image != blank %}
            <img  src="{{ block.settings.image | img_url: '500x' }}" alt="opposable logo">
          {% endif %}
        </div>
        {% elsif block.type=='text' %}
        
        <div class="footer-text">
          <h3 style="margin:0px 30px;padding:20px 0px;border-top:3px solid #464646;text-align:center;color:white">{{ block.settings.footer_text }}</h3>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "checkbox",
        "id": "show_certificate",
        "label": "Show Certification Image",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "certificate",
        "label": "Certification Image"
      },
      {
        "type": "checkbox",
        "id": "show_region_select",
        "label": "Show region selector",
        "default": true
      }
    ],
    "blocks": [
      {
        "type":"text",
        "name":"Footer Text",
        "settings": [
          {
              "type": "text",
              "id": "footer_text",
              "label": "Footer Text",
              "default": "Opposable C 2000-2023, All Rights Reserves"
          }
        ]
      },
      {
        "type": "image",
        "name": "Footer Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Footer Image"
          }
        ]
      },
      {
        "type": "menu",
        "name": "Menu",
        "limit": 3,
        "settings": [
          {
            "id": "block_linklist",
            "type": "link_list",
            "label": "Menu"
          }
        ]
      },
      {
        "type": "social_media",
        "name": "Social Media Links",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Follow Us"
          },
          {
            "type": "url",
            "id": "facebook_url",
            "label": "Facebook URL"
          },
          {
            "type": "url",
            "id": "twitter_url",
            "label": "Twitter URL"
          },
          {
            "type": "url",
            "id": "instagram_url",
            "label": "Instagram URL"
          }
        ]
      }
    ]
  }
{% endschema %}
