

{%- assign image_block = section.blocks | where: 'type', 'image' | first -%}
{% style %}
   .footer{
    width:100%;
   
    background:black;
    color:#ffffff;
   }
   .footer-grid{
     display:flex;
     flex-direction:column;
    }

    .footer-top{
     display:grid;
     grid-template-columns:1fr 1fr;
    }
    .footer-menu__title{
      font-family: Assistant, sans-serif;
      font-weight: 600;
      font-size: 26px;
      line-height: 31.2px;
      letter-spacing: 0%;
      text-align: center;
      margin-bottom:0px;
      margin-top:20px;
      padding-left:0;
      color:rgb(95, 95, 95);
    }

    .footer-menu__list{
     list-style:none;
     padding:0px;
    }

   .footer-menu__list-item a, .footer-socials a{
    text-decoration:none;
    color:#ffffff;
    font-family: Assistant, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 21px;
    letter-spacing: 0%;
    text-align: center;

   }
   
    .footer-socials{
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .footer-socials a{
      padding-bottom:5px;text-align: left;
    }
   .footer-menu{
     display:flex;
     flex-direction:column;
     align-items:flex-start;
     padding-left:35px;
   }
   .footer-logo{
    display: flex;
    justify-content: center;
    align-items: center;
    margin:20px auto;
   }
   .footer-logo img{
    width:90%;
    height:121px;
   }

   .footer-text{
    font-family: Assistant, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 16.8px;
    letter-spacing: 0%;
    text-align: center;
   }
   .footer-text h3{
      margin:0px 30px;
      padding:20px 0px;
      border-top:3px solid rgb(95, 95, 95);
      text-align:center;
      color:white
    }
   @media screen and (min-width: 600px)
   {
    .footer-grid{
     display:flex;
     flex-direction:row-reverse;
    }
    .footer-bottom{
      flex:1;
      flex-wrap:wrap;
    }
   
    .footer-top {
        display: flex;
        flex:1;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    .footer-menu--menu{
        height:300px;
        padding-right:50px;
        padding-top:50px;
    }

    /* Ensuring social links block appears below menu blocks */
    .footer-menu--social_media {
       position:relative;
        width: 100%;
        display: flex;
        justify-content: flex-end;
        padding-top: 10px;
        padding-bottom: 20px;
        padding-left:100px;
        border-top:3px solid rgb(95, 95, 95);
        margin-right:30px;
    }

    .footer-menu--social_media h3
    {
      display:none;
    }

    /* Display social media links in a row */
    .footer-socials {
        display: flex;
        flex-direction: row;
        gap: 15px;
        width:100%;
        justify-content:flex-end;
        
        /* position:absolute;
        right:20px;
        top:10px; */
    }
    .footer-socials a{
      border:2px solid white;
      border-radius:20px;
      padding:5px 10px;
      margin-right:15px;
    }
    .footer-logo{
      margin:0px;
    }
    .footer-logo img{
      height:200px;
      background-size:cover;
    }

    .footer-text h3{
      margin:0px;
      text-align:left;
      margin-left:30px;
    }
   }
{% endstyle %}
<footer
  class="footer{% if image_block %} footer--has-image{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="footer"
  
>
  
  <div class="footer-grid">
    <div class="footer-top">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = false
          case block.type
            when 'text'
              continue
            when 'image'
              continue
            when 'menu'
              assign title = linklists[block.settings.block_linklist].title
            when 'social_media'
              assign title = block.settings.title
          endcase
        -%}
        <div class="footer-menu footer-menu--{{ block.type }}">
          {% if title != blank %}
            <h3 class="footer-menu__title h6">{{ title }}</h3>
          {% endif %}

          {%- if block.type == 'menu' -%}
            <ul class="footer-menu__list" role="list">
              {% for link in linklists[block.settings.block_linklist].links %}
                <li class="footer-menu__list-item body-medium" role="listitem">
                  <a href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {% endfor %}
            </ul>
          {%- elsif block.type == 'social_media' -%}
            <div class="footer-socials" style="margin-top:18px">
              {% if block.settings.facebook_url != blank %}
                <a href="{{ block.settings.facebook_url }}" target="_blank">FACEBOOK</a>
              {% endif %}
              {% if block.settings.twitter_url != blank %}
                <a href="{{ block.settings.twitter_url }}" target="_blank">TWITTER</a>
              {% endif %}
              {% if block.settings.instagram_url != blank %}
                <a href="{{ block.settings.instagram_url }}" target="_blank">INSTAGRAM</a>
              {% endif %}
              {% if block.settings.linkedin_url != blank %}
                <a href="{{ block.settings.linkedin_url }}" target="_blank">LINKEDIN</a>
              {% endif %}
            </div>
          {%- endif -%}
        </div>
      {% endfor %}
    </div>
    <div class="footer-bottom">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = false
          case block.type
            when 'text'
            assign title = block.id
            when 'image'
            assign title = block.id
            when 'menu'
            continue
            when 'social_media'
            continue
          endcase
        -%}
        {%- if block.type == 'image' -%}
        <div class="footer-logo" style="height: 300px;">
          {% if block.settings.image != blank %}
            <img  src="{{ block.settings.image | img_url: '1000x' }}" alt="opposable logo">
          {% endif %}
        </div>
        {% elsif block.type=='text' %}
        
        <div class="footer-text">
          <h3>{{ block.settings.footer_text }}</h3>
        </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</footer>
<script>
  
  function adjustFooterLogoHeight() {
    const menu = document.querySelector('.footer-menu--menu');
    const logo = document.querySelector('.footer-logo');

    if (menu && logo) {
        logo.style.height = `${menu.offsetHeight}px`;
    }
}

// Run the function after the page loads
window.addEventListener('load', adjustFooterLogoHeight);
window.addEventListener('resize', adjustFooterLogoHeight);

  </script>
{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "header",
        "content": "Section Settings"
      },
      {
        "type": "checkbox",
        "id": "show_certificate",
        "label": "Show Certification Image",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "certificate",
        "label": "Certification Image"
      },
      {
        "type": "checkbox",
        "id": "show_region_select",
        "label": "Show region selector",
        "default": true
      }
    ],
    "blocks": [
      {
        "type":"text",
        "name":"Footer Text",
        "settings": [
          {
              "type": "text",
              "id": "footer_text",
              "label": "Footer Text",
              "default": "Opposable C 2000-2023, All Rights Reserves"
          }
        ]
      },
      {
        "type": "image",
        "name": "Footer Image",
        "settings": [
          {
            "type": "image_picker",
            "id": "image",
            "label": "Footer Image"
          }
        ]
      },
      {
        "type": "menu",
        "name": "Menu",
        "limit": 3,
        "settings": [
          {
            "id": "block_linklist",
            "type": "link_list",
            "label": "Menu"
          }
        ]
      },
      {
        "type": "social_media",
        "name": "Social Media Links",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Follow Us"
          },
          {
            "type": "url",
            "id": "facebook_url",
            "label": "Facebook URL"
          },
          {
            "type": "url",
            "id": "twitter_url",
            "label": "Twitter URL"
          },
          {
            "type": "url",
            "id": "instagram_url",
            "label": "Instagram URL"
          },
          {
            "type": "url",
            "id": "linkedin_url",
            "label": "Linkedin URL"
          }
        ]
      }
    ]
  }
{% endschema %}
